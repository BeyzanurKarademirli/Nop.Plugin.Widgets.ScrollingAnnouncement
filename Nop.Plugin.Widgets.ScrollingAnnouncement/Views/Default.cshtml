@model IList<Nop.Plugin.Widgets.ScrollingAnnouncement.Models.AnnouncementModel>
@{
    var bgColor = ViewData["BackgroundColor"] as string;
    if (string.IsNullOrWhiteSpace(bgColor))
    {
        bgColor = "#FFFDE7";
    }
}

@if (Model != null && Model.Any())
{
    @Html.Raw($@"
    <style>
        .scrolling-announcement-container {{
            width: 100%;
            overflow: hidden;
            background-color: {bgColor};
            border-top: 1px solid #ddd;
            border-bottom: 1px solid #ddd;
            padding: 10px 0;
            position: relative;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.04);
            margin-bottom: 15px;
            font-weight: 700;
            font-size: 15px;
            z-index: 999;
            -webkit-transform: translateZ(0);
            transform: translateZ(0);
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }}

        .scrolling-announcement-track {{
            display: flex;
            align-items: center;
            white-space: nowrap;
            width: max-content;
            will-change: transform;
            animation: scroll-text-continuous 18s linear infinite;
            -webkit-animation: scroll-text-continuous 18s linear infinite;
        }}

        .scrolling-announcement-container:hover .scrolling-announcement-track {{
            animation-play-state: paused;
            -webkit-animation-play-state: paused;
        }}

        .scrolling-announcement-item {{
            display: inline-flex;
            align-items: center;
            padding: 0 45px;
        }}

        .scrolling-announcement-text {{
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.3px;
        }}

        @keyframes scroll-text-continuous {{
            0% {{
                transform: translate3d(0, 0, 0);
                -webkit-transform: translate3d(0, 0, 0);
            }}
            100% {{
                transform: translate3d(-50%, 0, 0);
                -webkit-transform: translate3d(-50%, 0, 0);
            }}
        }}

        @-webkit-keyframes scroll-text-continuous {{
            0% {{
                -webkit-transform: translate3d(0, 0, 0);
            }}
            100% {{
                -webkit-transform: translate3d(-50%, 0, 0);
            }}
        }}
    </style>
    ")

    <div class="scrolling-announcement-container">
        <div class="scrolling-announcement-track">
            <!-- 1. Tur Duyurular -->
            @foreach (var item in Model)
            {
                var textColor = string.IsNullOrWhiteSpace(item.Color) ? "#111111" : item.Color;
                <div class="scrolling-announcement-item">
                    <span class="scrolling-announcement-text" style="color: @textColor !important;">@item.Text</span>
                </div>
            }

            <!-- 2. Tur Duyurular (Kesintisiz Sonsuz Akış) -->
            @foreach (var item in Model)
            {
                var textColor = string.IsNullOrWhiteSpace(item.Color) ? "#111111" : item.Color;
                <div class="scrolling-announcement-item">
                    <span class="scrolling-announcement-text" style="color: @textColor !important;">@item.Text</span>
                </div>
            }
        </div>
    </div>
}
