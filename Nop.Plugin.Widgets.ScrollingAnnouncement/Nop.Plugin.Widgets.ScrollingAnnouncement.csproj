<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Copyright>Copyright © Beyzanur</Copyright>
    <Company>Beyzanur</Company>
    <Authors>Beyzanur</Authors>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl>https://github.com/BeyzanurKarademirli/Nop.Plugin.Widgets.ScrollingAnnouncement</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Widgets.ScrollingAnnouncement</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <!-- Set this parameter to true if the plugin has a custom view -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" />
    <ClearPluginAssemblies Include="$(OutDir)\*.dll" />
  </ItemGroup>

  <!-- This target copies plugin.json and Views to Presentation/Nop.Web/Plugins/Widgets.ScrollingAnnouncement -->
  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Views\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
